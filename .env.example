# Enable the audio narration player. Off by default. Set to "true" only after
# generating audio files via `npm run build:audio` (which requires the Kokoro
# Python toolchain and substantial GPU/CPU time).
# PUBLIC_AUDIO_ENABLED=true

# Google Search Console verification token. Paste the value Google gives you
# under Search Console → Add property → URL prefix → HTML tag method
# (everything between content="..." in the snippet). When set, the layout
# emits <meta name="google-site-verification" content="..."> in <head>.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# View counter (Upstash Redis). These variables are AUTO-POPULATED by Vercel
# when an Upstash Redis store is linked to the project (Vercel dashboard →
# Project → Storage → Create Database → Upstash, then "Connect Project"). The
# integration injects the KV-style names below; the code reads
# KV_REST_API_URL / KV_REST_API_TOKEN (and falls back to the
# UPSTASH_REDIS_REST_* pair if present). `vercel env pull` syncs them to
# `.env.local` for local development. There is no need to set them by hand on
# Vercel. Locally, leaving them unset is fine — the `/api/views/*` endpoints
# return `{ count: null, error: "kv_unavailable" }` and the UI keeps its `—`
# placeholder. See DEPLOY.md → "View counter — Upstash Redis setup".
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=   # injected but unused by the counter
# KV_URL=                        # TCP connection string, unused by the counter
# REDIS_URL=                     # TCP connection string, unused by the counter

# Email newsletter (SMTP or Resend + the same Upstash Redis as the view
# counter). The newsletter subscriber store reuses the KV_REST_API_* /
# UPSTASH_REDIS_REST_* credentials above; the vars below configure delivery and
# the weekly cron. Unlike the view counter, the newsletter does NOT degrade
# silently: if the selected transport's config is unset the /api/newsletter/*
# endpoints return HTTP 500 rather than faking a successful signup. Leaving them
# unset locally is fine — the endpoints just error, while the prerendered
# /newsletter/* pages still build and render. See DEPLOY.md → "Email newsletter
# — email transport + Cron setup".
#
# EMAIL_TRANSPORT  — which delivery path to use: "smtp" (default when unset) or
#                    "resend". No auto-fallback: the selected transport's vars
#                    must be present or delivery throws.
# NEWSLETTER_FROM  — the From header, used by BOTH transports, e.g.
#                    "Action Models <you@example.com>". For smtp this is the
#                    email you verified as a sender in Brevo; for resend it must
#                    be on a domain verified in Resend.
# CRON_SECRET      — shared secret Vercel Cron sends as `Authorization: Bearer`.
#                    Vercel injects this automatically to scheduled cron
#                    invocations once it is set as a project env var.
# EMAIL_TRANSPORT=smtp
# NEWSLETTER_FROM=
# CRON_SECRET=
#
# --- smtp transport (default): Brevo SMTP, works without owning a domain -----
# Create a free Brevo account, verify a sender email (click the link Brevo
# emails you — no domain purchase required), then generate an SMTP key under
# "SMTP & API". Free tier: 300 emails/day.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=            # your Brevo login / SMTP username
# SMTP_PASS=            # the Brevo SMTP key (not your account password)
#
# --- resend transport: for the "resend" transport, once you have a verified
# --- domain. Verify a domain in Resend, set NEWSLETTER_FROM to an address on
# --- it, then flip EMAIL_TRANSPORT=resend. https://resend.com/api-keys
# RESEND_API_KEY=
#
# SITE_URL is already documented for the build (canonical URLs); it is also
# reused for the absolute confirm/unsubscribe/read links in newsletter emails,
# falling back to the canonical production origin when unset.
# SITE_URL=
